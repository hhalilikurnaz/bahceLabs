# Planning API mode: mock | real
VITE_PLANNING_API_MODE=real

# Vite geliştirme proxy'si /api isteklerini bu adrese yönlendirir (zorunlu)
API_PROXY_TARGET=http://localhost:8001

# Backend base URL (tarayıcıdan): yerelde /api
VITE_PLANNING_API_BASE_URL=/api

# Kayıt formu: true ise /register gerçek form gösterir (sunucu REGISTRATION_ENABLED ayrıca zorunlu)
VITE_REGISTRATION_ENABLED=true

# MapTiler anahtarı yalnızca .env.local içinde tutulur (commit edilmez)
VITE_MAPTILER_KEY=

# Mapbox Satellite (ana altlık) — yalnızca .env.local içinde tutulur (commit edilmez)
VITE_MAPBOX_TOKEN=
