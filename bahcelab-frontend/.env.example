# Planning API mode: mock | real
VITE_PLANNING_API_MODE=real

# Vite geliştirme proxy'si /api isteklerini bu adrese yönlendirir (zorunlu)
API_PROXY_TARGET=http://localhost:8001

# Backend base URL (tarayıcıdan): yerelde /api
VITE_PLANNING_API_BASE_URL=/api

# Kayıt formu: true ise /register hesap formu gösterir (sunucu REGISTRATION_ENABLED ayrıca zorunlu).
# false/boş ise aynı adres erken erişim (bekleme listesi) formunu gösterir: e-posta + il + ürün + KVKK açık rızası.
VITE_REGISTRATION_ENABLED=true

# KVKK aydınlatma metni (/kvkk): veri sorumlusunun unvanı ve başvuru e-postası. Boşsa metin yalnız sosyal kanalları gösterir (uydurma bilgi yazılmaz).
# KVKK metni hukuki onay bekliyor (taslak): boş/true iken canlı derlemede bekleme formu kapalıdır. Onaydan sonra false.
VITE_KVKK_TASLAK=true
VITE_KVKK_VERI_SORUMLUSU=
VITE_KVKK_ILETISIM_EPOSTA=

# MapTiler anahtarı yalnızca .env.local içinde tutulur (commit edilmez)
VITE_MAPTILER_KEY=

# Mapbox Satellite (ana altlık) — yalnızca .env.local içinde tutulur (commit edilmez)
VITE_MAPBOX_TOKEN=
