# Kök ortam değişkenleri: docker compose ve uçtan uca testler bunları okur. Kopyalayın: cp .env.example .env
# Geliştirme veritabanı (backend DATABASE_URL ile aynı port)
DB_PORT=5434
DB_CONTAINER=bahcelab-db

# Geliştirme sunucuları
API_PORT=8001
WEB_PORT=5173

# Uçtan uca testler: ayrı veritabanı, ayrı API ve web portları (geliştirme sunucularıyla çakışmaz)
E2E_DB_PORT=5435
E2E_DB_NAME=bahcelab_e2e
E2E_DB_CONTAINER=bahcelab-db-e2e
E2E_API_PORT=8011
E2E_WEB_PORT=5183

# NASA Earthdata (9E: Landsat/ERA5/SMAP). Değeri yalnız yerel .env'de; repoya girmez.
EARTHDATA_TOKEN=
