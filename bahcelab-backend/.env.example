# Database
DATABASE_URL=postgresql+asyncpg://bahcelab:bahcelab@localhost:5434/bahcelab
# Veri değiştiren betikler: pg_dump yedeği bu konteynerden alınır ve bu klasöre yazılır
DB_CONTAINER=bahcelab-db
BACKUP_DIR=backups

# API
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=true

# CORS — frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — JWT httpOnly cookie'leri
# Üretimde JWT_SECRET'ı uzun rastgele bir değerle değiştirin (örn: openssl rand -hex 32).
# API_DEBUG=false iken varsayılan sırla başlatma reddedilir.
JWT_SECRET=dev-insecure-secret-change-me-0123456789
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Yerelde false; HTTPS'te (api.bahcelabs.com) true olmalı
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Üretimde ".bahcelabs.com" (api. ve ana alan adı arasında paylaşım için); yerelde boş bırakın
COOKIE_DOMAIN=
# Yeni kayıt: yerelde true, canlıda erken erişim bitene kadar false
REGISTRATION_ENABLED=true

# NDVI (Sentinel-2) — Planetary Computer'a anahtar gerekmez
NDVI_ENABLED=true
NDVI_MONTHS=13
NDVI_MAX_PARALLEL_SCENES=2
NDVI_REFRESH_HOURS=12
# NDVI PNG'lerinin yazıldığı klasör (ileride S3/R2 için StorageBackend uygulanır)
STORAGE_DIR=uploads

# Hava durumu (Open-Meteo) — ücretsiz planda anahtar gerekmez; ticari kullanımda ücretli plan anahtarı
OPEN_METEO_API_KEY=
WEATHER_CACHE_MINUTES=60

# NASA Earthdata (9E). Değeri yalnız yerel .env'de
EARTHDATA_TOKEN=

# Zamanlanmış işler (ADR 0009): JOB_BACKEND=arq iken
REDIS_URL=redis://localhost:6379/0
